# provider: openai | anthropic
AGENT_PROVIDER=openai
AGENT_MODEL=glm-4-flash
AGENT_THINK=true

# OpenAI 兼容接口（智谱等）
OPENAI_API_KEY=你的智谱APIKey
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Anthropic
ANTHROPIC_API_KEY=你的AnthropicAPIKey
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 外置工具包目录
PACKAGES_DIR=packages

# 可用外置包白名单，逗号分隔；留空表示目录下全部可用
AGENT_PACKAGES=echo,writing_style,yuki_persona
# 启动即加载的外置包，逗号分隔；例如 AGENT_PACKAGES_PRELOAD=yuki_persona
AGENT_PACKAGES_PRELOAD=yuki_persona,echo

# 上下文预算与历史保留（超限时压缩旧消息）
AGENT_MAX_CONTEXT_TOKENS=12000
AGENT_KEEP_RECENT_MESSAGES=10

# 长期记忆检索条数
AGENT_MEMORY_LIMIT=5

# 长期记忆命名空间（每个机器人/软件一个）
AGENT_NAMESPACE=default

# provider 瞬时错误重试
AGENT_RETRY_MAX=3
AGENT_RETRY_BASE=0.5

# 单轮对话最多允许的连续工具调用次数，超限后强制模型直接回答
AGENT_MAX_TOOL_ROUNDS=8

# 会话数据目录（JSONL 消息 + SQLite 索引）
DATA_DIR=data
