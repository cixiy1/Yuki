{
  "id": "echo",
  "name": "回声工具包",
  "version": "1.0.0",
  "description": "演示 command 类型的工具入口",
  "tools": [
    {
      "name": "echo_text",
      "description": "把一段文本原样返回",
      "parameters": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "description": "要返回的文本"
          }
        }
      },
      "entry": {
        "type": "command",
        "command": ["{python}", "scripts/echo.py"]
      }
    }
  ]
}
